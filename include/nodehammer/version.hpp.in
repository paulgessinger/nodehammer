#pragma once

#include <nodehammer/api.hpp>

#include <string_view>

namespace nodehammer {

inline constexpr std::string_view VERSION = "@NODEHAMMER_VERSION@";
inline constexpr int VERSION_MAJOR = @NODEHAMMER_VERSION_MAJOR@;
inline constexpr int VERSION_MINOR = @NODEHAMMER_VERSION_MINOR@;
inline constexpr int VERSION_PATCH = @NODEHAMMER_VERSION_PATCH@;

// The version *linked*, as against VERSION above, which is the version the
// headers were *compiled against*. For a shared library those can differ, and
// only the out-of-line form reports the former — which also makes this the one
// entity proving a consumer is really talking to libnodehammer rather than just
// reading its headers.
//
// Step 6 answered the "final home" question by leaving it here. The API sketch
// filed it under diagnostics.hpp, but that was a listing artefact: `VERSION` and
// `version()` are the two halves of one question — compiled-against versus
// linked — and splitting them across headers would mean a consumer includes
// diagnostics.hpp to compare against a constant that lives somewhere else.
NH_API std::string_view version() noexcept;

} // namespace nodehammer
