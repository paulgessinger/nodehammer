namespace nodehammer.fbs;

// Wrapper so we can store an array of byte buffers (one per mip).
// FlatBuffers does not allow `[[ubyte]]` directly.
table IblMip {
    data:[ubyte];
}

table IblCache {
    /// Bumped whenever the bake algorithm or output layout changes,
    /// so stale caches miss instead of loading garbage.
    version:uint32;
    brdf_lut:[ubyte];
    irradiance:[ubyte];
    prefilter_mips:[IblMip];
}

root_type IblCache;
file_identifier "NHIB";
