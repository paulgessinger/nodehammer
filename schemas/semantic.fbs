namespace nodehammer.fbs;

struct Vec3f {
    x:float; y:float; z:float;
}

struct DVec3 {
    x:double; y:double; z:double;
}

struct Triangle {
    v0:DVec3;
    v1:DVec3;
    v2:DVec3;
}

struct Section {
    z:double;
    r_min:double;
    r_max:double;
}

struct TagRef {
    key:uint8;
    value:uint8;
}

// --- Shape tables ---

table BoxShape       { dx:double; dy:double; dz:double; }
table TubeShape      { r_min:double; r_max:double; dz:double; phi_start:double; phi_delta:double; }
table ConeShape      { r_min1:double; r_max1:double; r_min2:double; r_max2:double; dz:double; phi_start:double; phi_delta:double; }
table TrdShape       { dx1:double; dx2:double; dy1:double; dy2:double; dz:double; }
table ParaShape      { dx:double; dy:double; dz:double; alpha:double; theta:double; phi:double; }
table PconShape      { phi_start:double; phi_delta:double; sections:[Section]; }
table PgonShape      { phi_start:double; phi_delta:double; n_sides:int; sections:[Section]; }
table TorusShape     { r_min:double; r_max:double; r_tor:double; phi_start:double; phi_delta:double; }
table TessellatedShape { triangles:[Triangle]; }
table BooleanUnion        { left:uint32; right:uint32; right_transform_index:uint32; }
table BooleanIntersection { left:uint32; right:uint32; right_transform_index:uint32; }
table BooleanSubtraction  { left:uint32; right:uint32; right_transform_index:uint32; }
table UnknownShape   { original_type:string; }

union ShapeData {
    BoxShape,
    TubeShape,
    ConeShape,
    TrdShape,
    ParaShape,
    PconShape,
    PgonShape,
    TorusShape,
    TessellatedShape,
    BooleanUnion,
    BooleanIntersection,
    BooleanSubtraction,
    UnknownShape
}

table Shape {
    id:uint32;
    data:ShapeData;
}

// --- Material ---

table Material {
    id:uint32;
    name:string;
    has_color:bool;
    color:Vec3f;
    density:double;
}

// --- Logical Volume ---

table DaughterPlacement {
    name:string;
    log_vol_id:uint32;
    transform_index:uint32;
}

table LogicalVolume {
    id:uint32;
    name:string;
    shape_id:uint32;
    material_id:uint32;
    daughters:[DaughterPlacement];
}

// --- Transform pool (global) ---

table TransformPool {
    // Rotation rows: 3x3 matrices flattened column-major (9 doubles each).
    // Index j spans rotations[j*9 .. j*9+9)
    rotations:[double];
    // Translation rows: (x,y,z), 3 doubles each.
    // Index j spans translations[j*3 .. j*3+3)
    translations:[double];
    // Transform rows map to a (rotation, translation) pair.
    transform_rot_indices:[uint32];
    transform_trl_indices:[uint32];
}

// --- Nodes (column-oriented) ---

table NodeColumns {
    // Parallel arrays — index i corresponds to node i.
    ids:          [uint32];
    log_vol_ids:  [uint32];

    // Node names: index into a string table.
    name_table:   [string];
    name_indices: [uint32];

    // Node transform references global TransformPool rows.
    transform_indices:[uint32];

    // Parent: 0 = no parent (root node).
    parent_ids:   [uint32];

    // Tags per node: tag_counts[i] entries in tag_refs.
    // Decoder walks nodes in order with a running cursor over tag_refs.
    tag_counts:        [uint8];
    tag_key_table:     [string];
    tag_refs:          [TagRef];
    tag_value_table:   [string];

    // Source system: index into a small string table.
    source_system_table:   [string];
    source_system_indices: [uint8];

    // Degradation flags — one byte per node, 0 = none.
    degradation:  [uint8];
}

// --- Scene (root) ---

table SemanticScene {
    root_id:uint32;
    source_file:string;
    transforms:TransformPool;
    nodes:NodeColumns;
    log_vols:[LogicalVolume];
    shapes:[Shape];
    materials:[Material];
}

root_type SemanticScene;
file_identifier "NHS5";
file_extension "nhb";
