<lccdd>
  <info name="shared_world" title="Open DD4hep world for shared-import tests"
        author="nodehammer" status="test" version="1"/>
  <!-- Load normal DD4hep elements/materials and initialise the world, but let
       the test construct its reusable volumes before closing the geometry. -->
  <geometry close="false"/>
  <define>
    <constant name="world_x" value="10000*mm"/>
    <constant name="world_y" value="10000*mm"/>
    <constant name="world_z" value="10000*mm"/>
  </define>
  <includes>
    <gdmlFile ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
  </includes>
  <materials>
    <material name="Vacuum">
      <D type="density" unit="g/cm3" value="1e-25"/>
      <fraction n="1.0" ref="N"/>
    </material>
    <material name="Air">
      <D type="density" unit="g/cm3" value="0.00129"/>
      <fraction n="0.754" ref="N"/>
      <fraction n="0.246" ref="O"/>
    </material>
  </materials>
</lccdd>
