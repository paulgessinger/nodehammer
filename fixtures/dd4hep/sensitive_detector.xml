<lccdd>
  <info name="sensitive_detector" title="Sensitive detector test geometry"
        author="nodehammer" status="test" version="1"/>

  <define>
    <constant name="world_side"   value="1000*mm"/>
    <constant name="world_x"      value="world_side"/>
    <constant name="world_y"      value="world_side"/>
    <constant name="world_z"      value="world_side"/>
    <constant name="tracker_half" value="100*mm"/>
  </define>

  <includes>
    <gdmlFile ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
  </includes>

  <materials>
    <material name="Vacuum">
      <D type="density" unit="g/cm3" value="1e-25"/>
      <fraction n="1.0" ref="N"/>
    </material>
    <material name="Air">
      <D type="density" unit="g/cm3" value="0.00129"/>
      <fraction n="0.754" ref="N"/>
      <fraction n="0.246" ref="O"/>
    </material>
  </materials>

  <readouts>
    <readout name="TrackerHits">
      <id>system:8,layer:4,module:14,strip:24</id>
    </readout>
  </readouts>

  <display>
    <vis name="TrackerVis" alpha="0.5" r="0.1" g="0.9" b="0.1"
         showDaughters="true" visible="true"/>
  </display>

  <solids>
    <box name="WorldSolid"   x="world_side"     y="world_side"     z="world_side"/>
    <box name="TrackerSolid" x="tracker_half*2" y="tracker_half*2" z="tracker_half*2"/>
  </solids>

  <structure>
    <volume name="Tracker_vol">
      <materialref ref="Silicon"/>
      <solidref    ref="TrackerSolid"/>
      <visref      ref="TrackerVis"/>
      <sensitive type="tracker"/>
    </volume>
    <volume name="world_volume">
      <materialref ref="Air"/>
      <solidref    ref="WorldSolid"/>
      <physvol>
        <volumeref ref="Tracker_vol"/>
        <position  name="center" x="0" y="0" z="0"/>
      </physvol>
    </volume>
  </structure>

  <detectors>
    <detector id="1" name="Tracker" type="DD4hep_SubdetectorAssembly" vis="TrackerVis"
              readout="TrackerHits">
      <composite name="Tracker_vol"/>
    </detector>
  </detectors>

  <setup name="Default" version="1.0">
    <world ref="world_volume"/>
  </setup>
</lccdd>
