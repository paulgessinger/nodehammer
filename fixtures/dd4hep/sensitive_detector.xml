<lccdd>
  <info name="sensitive_detector" title="Minimal sensitive tracker for testing"
        author="nodehammer" status="test" version="1"/>

  <define>
    <constant name="world_side" value="1000*mm"/>
    <constant name="world_x"    value="world_side"/>
    <constant name="world_y"    value="world_side"/>
    <constant name="world_z"    value="world_side"/>
  </define>

  <includes>
    <gdmlFile ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
  </includes>

  <materials>
    <material name="Vacuum">
      <D type="density" unit="g/cm3" value="1e-25"/>
      <fraction n="1.0" ref="N"/>
    </material>
    <material name="Air">
      <D type="density" unit="g/cm3" value="0.00129"/>
      <fraction n="0.754" ref="N"/>
      <fraction n="0.246" ref="O"/>
    </material>
  </materials>

  <readouts>
    <readout name="TrackerHits">
      <id>system:8,layer:4,module:14,sensor:8</id>
    </readout>
  </readouts>

  <solids>
    <box name="WorldSolid" x="world_side" y="world_side" z="world_side"/>
  </solids>

  <structure>
    <volume name="world_volume">
      <materialref ref="Air"/>
      <solidref    ref="WorldSolid"/>
    </volume>
  </structure>

  <detectors>
    <detector id="1" name="Tracker" type="DD4hep_SiTrackerBarrel" readout="TrackerHits">
      <module name="TestModule">
        <module_envelope width="50*mm" length="50*mm" thickness="1*mm"/>
        <module_component width="50*mm" length="50*mm" thickness="0.3*mm"
                          material="Silicon" sensitive="true"/>
      </module>
      <layer module="TestModule" id="1">
        <barrel_envelope inner_r="100*mm" outer_r="110*mm" z_length="200*mm"/>
        <rphi_layout phi_tilt="0" nphi="1" phi0="0" rc="105*mm" dr="0"/>
        <z_layout dr="0" z0="0" nz="1"/>
      </layer>
    </detector>
  </detectors>

  <setup name="Default" version="1.0">
    <world ref="world_volume"/>
  </setup>
</lccdd>
