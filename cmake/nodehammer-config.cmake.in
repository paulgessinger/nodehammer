@PACKAGE_INIT@

# Deliberately no find_dependency() calls. Every dependency is PRIVATE behind
# $<BUILD_INTERFACE:>, so none appears in INTERFACE_LINK_LIBRARIES and none has
# to be resolvable by a consumer (#41 §10).
#
# This is the payoff for not shipping the archive. A static nodehammer would
# leave every private dependency undefined until the consumer's final link, so
# this file would have to find_dependency() the lot — ten packages a consumer has
# no reason to know about. If that variant is ever added, this file grows the
# branch.
#
# Note this covers *linking*, and how a dependency is satisfied differs by kind.
# The static ones (zstd, flatbuffers, manifold, miniz, …) are absorbed into the
# library and disappear. A shared backend — ROOT or DD4hep, when those importers
# are enabled — stays a DT_NEEDED reference instead. Finding *that* at runtime is
# an rpath question, not a find_dependency one: CMAKE_INSTALL_RPATH_USE_LINK_PATH
# records where it was linked from, as DT_RUNPATH so LD_LIBRARY_PATH still wins.
#
# What would make find_dependency necessary is a public header including a
# backend header. That would put ROOT's include directories in the interface,
# which means ROOT::Geom becomes an INTERFACE dependency, which means a consumer
# has to resolve it. As long as no installed header names a backend type, the
# list above stays empty. That is the tripwire; this is the file that changes.

include("${CMAKE_CURRENT_LIST_DIR}/nodehammer-targets.cmake")

# ── MSVC: the consumer's C runtime has to match the library's ─────────────────
# This API passes owning std:: types across the boundary — std::string inside
# Diagnostic, std::vector out of toNhb() — and throws an exception across it.
# On MSVC all of that is defined only while both sides agree on the standard
# library's layout and on which heap frees what, and they do not agree across
# the debug/release split (_ITERATOR_DEBUG_LEVEL is 2 under a debug CRT and 0
# otherwise, which adds a proxy pointer to every container, so sizeof(std::string)
# is 40 against 32) nor across the static/dynamic one (/MT and /MD each carry
# their own heap).
#
# The failure that produces is silent and late. Everything compiles, everything
# links, and the first call returns an empty vector because the caller read a
# 32-byte object as 40; the process then dies freeing it. That is what CI's
# consumer hit — a Debug build picking up an env-set CMAKE_BUILD_TYPE against
# the Release library — and it is worth a configure-time error rather than a
# segmentation fault in somebody else's build.
#
# The comparison is on the fully resolved runtime name rather than a debug flag,
# so /MT against /MD is caught too. Only the single-config case is decidable
# here: a multi-config generator does not choose until build time, so it gets
# nothing rather than a guess.
set(_nh_lib_runtime "@NODEHAMMER_MSVC_RUNTIME@")
if(MSVC AND CMAKE_BUILD_TYPE AND NOT _nh_lib_runtime STREQUAL "")
    # CMake documents configuration handling as case-insensitive, so normalise
    # before classifying: -DCMAKE_BUILD_TYPE=debug is a debug build.
    string(TOLOWER "${CMAKE_BUILD_TYPE}" _nh_consumer_cfg)
    if(CMAKE_MSVC_RUNTIME_LIBRARY)
        string(REPLACE "$<$<CONFIG:Debug>:Debug>" "$<_NH_DEBUG_>"
               _nh_consumer_runtime "${CMAKE_MSVC_RUNTIME_LIBRARY}")
        if(_nh_consumer_cfg STREQUAL "debug")
            string(REPLACE "$<_NH_DEBUG_>" "Debug" _nh_consumer_runtime "${_nh_consumer_runtime}")
        else()
            string(REPLACE "$<_NH_DEBUG_>" "" _nh_consumer_runtime "${_nh_consumer_runtime}")
        endif()
    elseif(_nh_consumer_cfg STREQUAL "debug")
        set(_nh_consumer_runtime "MultiThreadedDebugDLL")
    else()
        set(_nh_consumer_runtime "MultiThreadedDLL")
    endif()

    if(NOT _nh_consumer_runtime STREQUAL _nh_lib_runtime)
        message(FATAL_ERROR
            "nodehammer was built against the ${_nh_lib_runtime} MSVC runtime, but this "
            "project resolves to ${_nh_consumer_runtime} (CMAKE_BUILD_TYPE="
            "${CMAKE_BUILD_TYPE}). Mixing MSVC runtimes is undefined whenever std:: types "
            "or exceptions cross a DLL boundary, which nodehammer's API does. Build "
            "against a matching configuration.")
    endif()
    unset(_nh_consumer_cfg)
    unset(_nh_consumer_runtime)
endif()
unset(_nh_lib_runtime)

check_required_components(nodehammer)
